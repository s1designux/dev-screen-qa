{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/sync-agents-md.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "AGENTS.md 링크 확인 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/시험지보호.py\"",
            "timeout": 10,
            "statusMessage": "시험지 보호 확인"
          }
        ]
      }
    ]
  }
}
